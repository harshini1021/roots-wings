# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Change this to any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string-abc123xyz

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
# Where to store the database file (default: data/rootswings.db next to package.json)
# DB_PATH=./data/rootswings.db

# Server port (Render sets this automatically)
PORT=5000

# Your Vercel frontend URL — used for CORS and email links
FRONTEND_URL=https://your-project.vercel.app

# Email (Gmail) — leave blank to skip emails during development
# To enable: use a Gmail App Password (not your normal password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youremail@gmail.com
# SMTP_PASS=your-gmail-app-password
# EMAIL_FROM=Roots & Wings <youremail@gmail.com>
