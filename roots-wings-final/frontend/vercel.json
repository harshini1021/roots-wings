{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "public",
  "env": {
    "API_URL": "https://your-render-backend.onrender.com"
  }
}
